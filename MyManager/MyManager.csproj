<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-preview.7.26381.103" />
        <PackageReference Include="RazorSlices" Version="0.11.3" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\MyManager.SourceGenerators\MyManager.SourceGenerators\MyManager.SourceGenerators.csproj" OutputItemType="Analyzer" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Modules\ProjectBoard\Slices\Hello.cshtml" />
      <_ContentIncludedByDefault Remove="Modules\ProjectBoard\Slices\_ViewImports.cshtml" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="client\src\css\components\alert\" />
      <Folder Include="client\src\css\components\dialog\" />
      <Folder Include="client\src\css\components\form\" />
      <Folder Include="client\src\css\components\popover\" />
    </ItemGroup>

</Project>
